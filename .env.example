# Core Engine runtime configuration
CORE_ENGINE_API_KEY=replace-with-long-random-secret
# Set true only for an explicitly public/demo deployment.
CORE_ENGINE_ALLOW_ANONYMOUS=false

# Supabase server-side persistence
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy alias accepted by the runtime:
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI decision provider
AI_DECISION_ENDPOINT=
AI_DECISION_API_KEY=
AI_DECISION_MODEL=

# Signed audit chain
AUDIT_SIGNING_KEY=
HEALTH_DETAIL_TOKEN=

# In-memory limiter defaults (per runtime instance)
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

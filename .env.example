SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
CORE_ENGINE_WEBHOOK_ALLOWLIST=https://example.com
CORE_ENGINE_WEBHOOK_SECRET=
# Durable agent loop (ADR-001)
AGENT_LLM_BASE_URL=
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=
# or: ANTHROPIC_API_KEY= (with AGENT_LLM_MODEL set to an Anthropic model id)
AGENT_LLM_PRICE_IN_PER_MTOK=3
AGENT_LLM_PRICE_OUT_PER_MTOK=15
AGENT_MAX_COST_PER_RUN_USD=5
# AGENT_RUN_STORE=memory|file|supabase (default: supabase when SUPABASE_URL + server key are set, else file)
AGENT_RUN_STORE=
AGENT_RUN_DIR=.agent-runs
AGENT_WORKER_MODE=inline
# Per-client secrets for /api/integrations: {"bet-builder":"<secret>",...}
CORE_ENGINE_INTEGRATION_KEYS_JSON=
# Anonymous demo mode LLM caps (only when CORE_ENGINE_ALLOW_ANONYMOUS=true)
ANON_LLM_PER_IP_PER_HOUR=10
ANON_LLM_DAILY=100
FCC_TENANT_ID=
WEBSITE_BUILD_TIMEOUT_MS=120000
# Code execution tool (worker only, ADR-002)
AGENT_SANDBOX=
AGENT_SANDBOX_NETWORK=on
AGENT_SANDBOX_MAX_TIMEOUT_MS=300000
